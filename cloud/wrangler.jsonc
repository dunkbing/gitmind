{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gitmind",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	// global_fetch_strictly_public: required to fetch MCP clients' metadata
	// documents (CIMD) safely.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// The marketing site and docs (site/, built with Astro). Static files are
	// served directly; everything else (the app, OAuth, /mcp) reaches the Worker.
	"assets": { "directory": "./site/dist", "binding": "ASSETS" },
	"observability": { "enabled": true },

	"vars": {
		// The public URL of this deployment, without a trailing slash. MCP
		// clients connect to PUBLIC_URL/mcp.
		"PUBLIC_URL": "https://gitmind.app",
		// GitHub OAuth App for signing in. With no GITHUB_CLIENT_SECRET, sign-in
		// uses GitHub's device flow, which needs only this public ID (gitmind's
		// own app, device flow enabled). For redirect sign-in, use your own app
		// and `wrangler secret put GITHUB_CLIENT_SECRET`.
		"GITHUB_CLIENT_ID": "Ov23liPvy5PXJaaqYI4N"
	},

	"durable_objects": {
		"bindings": [{ "name": "WORKSPACE", "class_name": "Workspace" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workspace"] }],

	// No IDs: the first `wrangler deploy` creates the database and KV
	// namespace, and later deploys keep using the ones the Worker is bound to.
	"d1_databases": [{ "binding": "DB", "database_name": "gitmind", "migrations_dir": "migrations" }],
	"kv_namespaces": [{ "binding": "OAUTH_KV" }],
	"artifacts": [{ "binding": "ARTIFACTS", "namespace": "gitmind" }],

	"routes": [{ "pattern": "gitmind.app", "custom_domain": true }]
}
