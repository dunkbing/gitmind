---
import Base from "../layouts/Base.astro";
import { DEFINITION, REPO, SITE } from "../lib/site.mjs";

const description =
	"Your AI agents stop forgetting. gitmind gives Claude, ChatGPT, Claude Code and Codex one shared memory: Markdown notes in a git repository you own, served to every AI app over MCP.";
const features = [
	["Works in every AI app", "One MCP endpoint for claude.ai on web, desktop and mobile, ChatGPT, Claude Code and Codex. What one app learns, the others know."],
	["Automatic", "Agents save decisions, preferences, gotchas and setup knowledge as short facts while they work, and load them when the next session starts. Nothing to approve."],
	["Facts stay current", "When something changes, the old fact moves to a dated History instead of contradicting the new one, and agents are warned when they save something that conflicts."],
	["Your memory is a git repo", "Every note is Markdown, every change is a commit. Clone it, read it in Obsidian, see its history, take it with you."],
	["Shared with your team", "Team workspaces share a memory between people and their agents, with invite links and roles."],
	["Open source", "AGPL-3.0. Use gitmind.app, or self-host it on your own Cloudflare account in a few minutes."],
];
// Questions people ask AI search about agent memory. Answers are HTML; the
// FAQPage structured data gets them as plain text.
const faq = [
	[
		"What is MCP memory?",
		'MCP (Model Context Protocol) is the open standard AI apps use to call outside tools. An MCP memory server gives an agent tools to search, read and save notes, so it remembers things between conversations. gitmind is one: the agent decides what to save, and gitmind stores, indexes and syncs it. See the <a href="/docs/tools/">tools it provides</a>.',
	],
	[
		"How do I give Claude Code persistent memory?",
		'Run <code>claude mcp add --transport http --scope user gitmind https://gitmind.app/mcp</code>, or install the gitmind CLI and run <code>gitmind setup</code>. The CLI keeps a synced local clone of your notes and adds hooks that load a project\'s notes at the start of every session and remind the agent to save what it learned. See <a href="/docs/cli/">CLI and local sync</a>.',
	],
	[
		"Can Claude and ChatGPT share the same memory?",
		'Yes. Add <code>https://gitmind.app/mcp</code> as a custom connector in claude.ai and in ChatGPT, and sign in to the same account in both. They read and write the same notes, as do Claude Code and Codex. See <a href="/docs/connect/">Connect your AI apps</a>.',
	],
	[
		"Is my memory private?",
		'Your personal workspace is readable only by you; team workspaces only by their members. Every app signs in with OAuth after a consent page, gitmind runs no LLM and never sees your conversations, only what an agent chooses to save or search, and it refuses to store notes that look like secrets. See <a href="/docs/security/">Security and privacy</a>.',
	],
	[
		"Can I self-host gitmind?",
		'Yes. gitmind is open source under AGPL-3.0 and deploys to your own Cloudflare account (Workers Paid plan) with a few commands. Or skip the server entirely: the CLI can sync notes through a private GitHub repository. See <a href="/docs/self-hosting/">Self-hosting</a>.',
	],
	[
		"How is gitmind different from ChatGPT or Claude's built-in memory?",
		'Built-in memory belongs to one app and is managed by its provider. gitmind is one memory shared by every AI app and machine you use, stored as Markdown files in git that you can read, edit, version, export and share with a team. See <a href="/docs/compare/">how gitmind compares</a>.',
	],
	["Is gitmind free?", 'Yes. gitmind.app is free to use with a GitHub sign-in, and the code is open source.'],
];
const text = (html: string) => html.replace(/<[^>]+>/g, "").replace(/&#39;/g, "'");
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "Organization",
			"@id": `${SITE}/#organization`,
			name: "gitmind",
			url: `${SITE}/`,
			logo: `${SITE}/icon-512.png`,
			sameAs: [REPO],
		},
		{
			"@type": "WebSite",
			"@id": `${SITE}/#website`,
			name: "gitmind",
			url: `${SITE}/`,
			description,
			inLanguage: "en",
			publisher: { "@id": `${SITE}/#organization` },
		},
		{
			"@type": "SoftwareApplication",
			"@id": `${SITE}/#software`,
			name: "gitmind",
			applicationCategory: "DeveloperApplication",
			applicationSubCategory: "AI agent memory (MCP server)",
			operatingSystem: "Web, macOS, Linux, Windows",
			description: DEFINITION,
			url: `${SITE}/`,
			image: `${SITE}/og.png`,
			downloadUrl: `${REPO}/releases`,
			installUrl: `${SITE}/docs/quickstart/`,
			softwareHelp: `${SITE}/docs/`,
			license: "https://www.gnu.org/licenses/agpl-3.0.html",
			isAccessibleForFree: true,
			publisher: { "@id": `${SITE}/#organization` },
			featureList: features.map(([title]) => title),
			offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
		},
		{
			"@type": "SoftwareSourceCode",
			name: "gitmind",
			codeRepository: REPO,
			programmingLanguage: ["Go", "TypeScript"],
			license: "https://www.gnu.org/licenses/agpl-3.0.html",
			targetProduct: { "@id": `${SITE}/#software` },
		},
		{
			"@type": "FAQPage",
			mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: text(a) } })),
		},
	],
};
---
<Base title="gitmind" description={description} jsonLd={jsonLd}>
	<section class="pt-4 md:pt-10">
		<p class="mb-5 text-[13px] uppercase tracking-[0.1em] text-muted">Memory for AI agents</p>
		<h1 class="text-[40px] leading-[1.1] md:text-[52px]">Your AI agents stop forgetting.</h1>
		<p class="mt-6 max-w-[600px] text-[17px] text-muted">
			Every new session starts from zero, so you re-explain your stack, your preferences and the bug you already fixed. gitmind gives
			Claude, ChatGPT, Claude Code and Codex one shared memory: agents save what they learn as they work and recall it next time, in
			whichever app you use. It's open source, and your memory is Markdown notes in a git repository you own.
		</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<a href="/app" class="rounded-md bg-accent px-4 py-2.5 text-accent-ink no-underline hover:opacity-90">Start with GitHub</a>
			<a href="/docs/quickstart/" class="rounded-md border border-line px-4 py-2.5 text-ink no-underline hover:bg-surface">Read the quickstart</a>
		</div>
	</section>

	<section aria-label="Setup" class="mt-16 rounded-xl border border-line bg-surface p-5 font-mono text-[13px] leading-relaxed md:p-6">
		<p class="text-muted"># claude.ai, ChatGPT: add a connector with this URL</p>
		<p>https://gitmind.app/mcp</p>
		<p class="mt-4 text-muted"># Claude Code</p>
		<p>claude mcp add --transport http gitmind https://gitmind.app/mcp</p>
		<p class="mt-4 text-muted"># or keep a synced clone on your laptop</p>
		<p>curl -fsSL https://gitmind.app/install.sh | sh</p>
		<p>gitmind setup</p>
	</section>

	<section class="mt-16 grid gap-x-10 gap-y-8 md:grid-cols-2" aria-labelledby="features">
		<h2 id="features" class="sr-only">Features</h2>
		{features.map(([title, body]) => (
			<div>
				<h3 class="text-[19px]">{title}</h3>
				<p class="mt-2 text-muted">{body}</p>
			</div>
		))}
	</section>

	<section class="mt-16">
		<h2 class="text-[26px]">How it works</h2>
		<ol class="mt-5 space-y-4 text-muted">
			<li><strong class="text-ink">Connect.</strong> Sign in with GitHub and add gitmind to your AI apps. Each one signs in to your memory once.</li>
			<li><strong class="text-ink">Work as usual.</strong> At the start of a session the agent loads what's relevant: pinned notes and an index of the project's notes. It searches when it needs more.</li>
			<li><strong class="text-ink">Keep what matters.</strong> When something is worth remembering, the agent writes it down as a short fact. Next time, in any app or on any machine, it already knows.</li>
		</ol>
		<p class="mt-8"><a href="/docs/how-it-works/">How gitmind works under the hood →</a></p>
	</section>

	<section class="mt-16" aria-labelledby="faq">
		<h2 id="faq" class="text-[26px]">Questions</h2>
		<div class="mt-5 divide-y divide-line border-y border-line">
			{faq.map(([q, a]) => (
				<div class="py-5">
					<h3 class="text-[18px]">{q}</h3>
					<p class="mt-2 text-muted [&_code]:font-mono [&_code]:text-[13px]" set:html={a} />
				</div>
			))}
		</div>
		<p class="mt-8"><a href="/docs/faq/">More questions and answers →</a></p>
	</section>
</Base>
