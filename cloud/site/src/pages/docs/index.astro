---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { SITE } from "../../lib/site.mjs";

const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const sections = ["Getting started", "Guides", "Reference"] as const;
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "CollectionPage",
			name: "gitmind documentation",
			url: `${SITE}/docs/`,
			isPartOf: { "@type": "WebSite", "@id": `${SITE}/#website`, name: "gitmind", url: `${SITE}/` },
			hasPart: docs.map((d) => ({ "@type": "TechArticle", headline: d.data.title, url: `${SITE}/docs/${d.id}/` })),
		},
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: "gitmind", item: `${SITE}/` },
				{ "@type": "ListItem", position: 2, name: "Docs", item: `${SITE}/docs/` },
			],
		},
	],
};
---
<Base title="Documentation" description="gitmind docs: set up shared AI memory, connect claude.ai, ChatGPT, Claude Code and Codex over MCP, sync notes with the CLI, work in teams, and self-host it." jsonLd={jsonLd}>
	<h1 class="text-[38px]">Documentation</h1>
	<p class="mt-4 text-[17px] text-muted">Everything about using, connecting and self-hosting gitmind, the shared memory for your AI agents. New here? Start with the <a href="/docs/introduction/">introduction</a> or jump to the <a href="/docs/quickstart/">quickstart</a>.</p>
	{sections.map((s) => (
		<section class="mt-10">
			<h2 class="text-[13px] font-sans uppercase tracking-[0.08em] text-muted">{s}</h2>
			<ul class="mt-3 divide-y divide-line border-y border-line">
				{docs.filter((d) => d.data.section === s).map((d) => (
					<li class="py-3"><a href={`/docs/${d.id}/`} class="font-serif text-[17px] no-underline">{d.data.title}</a><p class="text-[14px] text-muted">{d.data.description}</p></li>
				))}
			</ul>
		</section>
	))}
</Base>
