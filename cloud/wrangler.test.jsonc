// Test-only config: the same Worker without remote-only bindings (Artifacts
// is replaced by a local git server through DEV_GIT_BASE). Keep in sync with
// wrangler.jsonc.
{
	"name": "gitmind-test",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// The marketing site and docs (site/, built with Astro). Static files are
	// served directly; everything else (the app, OAuth, /mcp) reaches the Worker.
	"assets": { "directory": "./site/dist", "binding": "ASSETS" },
	"durable_objects": { "bindings": [{ "name": "WORKSPACE", "class_name": "Workspace" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workspace"] }],
	"d1_databases": [{ "binding": "DB", "database_name": "gitmind", "database_id": "test", "migrations_dir": "migrations" }],
	"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "test" }]
}
